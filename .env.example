# Copy this file to .env and fill in values. .env is gitignored and is never
# read by Claude's own Read/Edit tools (see .claude/settings.json), but it IS
# loaded into the sandbox container's environment via bin/sandbox.

# GitHub token for `gh` CLI inside the sandbox (repo create, PRs, etc).
# git push/pull over plain SSH does not need this; it uses ssh-agent forwarding instead.
GH_TOKEN=
